# Copy to .env and fill in. Never commit .env. See docs/configuration.md.
CDP_DOMAIN=certs.example.internal
POSTGRES_PASSWORD=change-me-long-random
REDIS_PASSWORD=change-me-long-random
# Master key lives in ./secrets/cdp_master_key (base64 of 32 random bytes):
#   mkdir -p secrets && head -c32 /dev/urandom | base64 > secrets/cdp_master_key && chmod 600 secrets/cdp_master_key
# BACK IT UP SEPARATELY — without it, encrypted keys and backups are unrecoverable.
CDP_COOKIE_SECURE=true
CDP_ENV=prod
CDP_PUBLIC_BASE_URL=https://certs.example.internal
CDP_CORS_ORIGINS=https://certs.example.internal
# The API sits behind the bundled Caddy proxy only:
CDP_TRUST_PROXY_HEADERS=true
# One-time bootstrap admin (only used when no users exist). Remove after first login.
CDP_BOOTSTRAP_ADMIN_USERNAME=admin
CDP_BOOTSTRAP_ADMIN_PASSWORD=
# Optional OIDC (e.g. Keycloak)
# CDP_OIDC_ISSUER=https://keycloak.example/realms/infra
# CDP_OIDC_CLIENT_ID=cert-deploy-pro
# CDP_OIDC_CLIENT_SECRET=
# CDP_OIDC_ADMIN_GROUPS=cdp-admins
# CDP_OIDC_OPERATOR_GROUPS=cdp-operators
CDP_WORKER_CONCURRENCY=4
